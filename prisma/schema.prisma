generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String
  role            String      @default("ATTENDEE") // "ATTENDEE", "ORGANIZER", "ADMIN"
  organization    String?
  jobTitle        String?
  avatarUrl       String?
  settingsJson    String?     // UI/UX & Account Preferences JSON
  interestsJson   String      @default("[]") // JSON Array of MICE interest tags
  passwordHash    String?     // scrypt hash; null means password login disabled
  emailVerifiedAt DateTime?   // Set on first verified login (either method)
  failedLoginAttempts Int     @default(0) // Reset on success; 5 trips a 15-minute lockout
  lockedUntilAt   DateTime?
  organizedEvents Event[]     @relation("OrganizerEvents")
  bookings        Booking[]
  claimedBooths   BoothTenant[] @relation("BoothClaims")
  meetingRequests MeetingRequest[] @relation("RequesterMeetings")
  aiReports       AIReport[]
  sessions        Session[]
  otpCodes        OtpCode[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Region {
  id          String   @id // "id", "jp", "global"
  name        String   // "Indonesia", "Japan", "Global"
  code        String   @unique // "ID", "JP", "GL"
  currency    String   @default("IDR") // "IDR", "JPY", "USD"
  description String?
  venues      Venue[]
  events      Event[]
}

model Venue {
  id          String      @id @default(cuid())
  regionId    String
  region      Region      @relation(fields: [regionId], references: [id])
  name        String      // e.g. "JIExpo Kemayoran"
  slug        String      @unique
  city        String
  address     String
  latitude    Float?
  longitude   Float?
  transitInfo String      // Transit instructions (KRL, MRT, TransJakarta)
  imageUrl    String?
  size        String      @default("LARGE") // Presentation tier suggestion: LARGE | MEDIUM | SMALL. Events choose explicitly; this never auto-applies.
  // Kind of place. Not the presentation tier above.
  type        String      @default("CONVENTION_CENTER") // CONVENTION_CENTER | EXHIBITION_CENTER | ARENA | STADIUM | MALL | HOTEL | COMMUNITY_HALL | OUTDOOR
  // DEFAULT means the backfill may set it; OPERATOR and SEED are authoritative.
  typeSource  String      @default("DEFAULT")
  // Venue-level capacity when the operator states one; otherwise the UI sums spaces.
  capacity    Int?
  halls       VenueHall[]
  events      Event[]
  createdAt   DateTime    @default(now())

  @@index([regionId, type])
}

model VenueHall {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name         String   // e.g. "Hall A1", "Nusantara Hall 2", "Plenary Hall"
  kind         String   @default("HALL") // HALL | MEETING_ROOM | ARENA | FIELD | COURT | ATRIUM | PAVILION | BALLROOM | OUTDOOR. Meeting rooms are listed deeper, never counted in the headline.
  capacity     Int?
  floorAreaSqm Float?
  ceilingHeightM Float? // Verified clear height in metres; null means unknown (UI shows a Typical estimate)
  floorLoadKnM2 Float? // Verified floor load in kN/m²; null means unknown (UI shows a Typical estimate)
  description  String?
  events       Event[]
}

model Event {
  id                 String       @id @default(cuid())
  organizerId        String?
  organizer          User?        @relation("OrganizerEvents", fields: [organizerId], references: [id])
  organizerName      String?      // External organizer brand or trade association
  isPlatformCurated  Boolean      @default(false)
  regionId           String
  region             Region       @relation(fields: [regionId], references: [id])
  venueId            String
  venue              Venue        @relation(fields: [venueId], references: [id])
  venueHallId        String?
  venueHall          VenueHall?   @relation(fields: [venueHallId], references: [id])
  venueHallIds       String?      // JSON array of ALL allocated hall IDs; venueHallId stays the primary hall relation
  isListingOnly      Boolean      @default(false) // Customizable public listing excluded from operations (dashboard, booths, scanner)
  externalUrl        String?      // Official off-platform listing URL for admin-curated listings
  title              String
  slug               String       @unique
  tagline            String?
  description        String
  archetype          String       @default("INDUSTRIAL_B2B") // INDUSTRIAL_B2B, TECH_DEV_SUMMIT, MEDICAL_SYMPOSIUM, FINANCE_INVESTOR, POP_CULTURE_GAMING, MUSIC_FESTIVAL, MEGA_EXPO_PAVILION, GOVERNMENT_DIPLOMATIC, INCENTIVE_RETREAT
  startDate          DateTime
  endDate            DateTime
  isFeatured         Boolean      @default(false)
  heroImageUrl       String?
  editorialBlurb     String?      // English-default editorial line for the hero carousel; renders only when editorialApproved
  editorialBlurbI18n Json?        // Optional per-locale overrides: { locale: text }
  editorialApproved  Boolean      @default(false) // Editorial publication gate: unapproved blurbs never render
  pageSize           String?      // Explicit human-chosen presentation tier: LARGE | MEDIUM | SMALL. Null means no choice yet.
  visibility         String       @default("PUBLIC") // PUBLIC | DISCREET (occupancy without identity) | HIDDEN (link-only)
  brandingConfigJson String?      // Custom primary color, accent, hero override JSON
  showcaseJson     String?      // Nullable organizer-authored showcase content (stream, programs, alerts, channels); absent means sections stay hidden
  scale              String       @default("LARGE") // "GLOBAL_MEGA", "LARGE", "MEDIUM", "EXECUTIVE"
  format             String       @default("IN_PERSON") // "IN_PERSON", "HYBRID", "VIRTUAL"
  ticketTiers        TicketTier[]
  agendaItems        AgendaItem[]
  booths             BoothTenant[]
  perks              EventPerk[]
  aiReports          AIReport[]
  bookings           Booking[]
  meetingRequests  MeetingRequest[]
  waitlist           WaitlistEntry[]
  updates            EventUpdate[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// Organizer-authored news for an event timeline. DRAFT is invisible
// everywhere except the author's preview; APPROVED renders on the event
// page and becomes eligible for hand-picked homepage slots.
model EventUpdate {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String?
  title     String
  body      String
  status    String   @default("DRAFT") // "DRAFT" | "APPROVED"
  approvedBy String?
  approvedAt DateTime?
  slots     HomepageNewsSlot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
}

// Hand-ordered homepage rail picks per region. Slots reference approved
// updates; deleting an update evicts its slot via cascade.
model HomepageNewsSlot {
  id       String      @id @default(cuid())
  updateId String      @unique
  update   EventUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  regionId String
  position Int

  @@unique([regionId, position])
  @@index([regionId])
}

model TicketTier {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String    // "Standard Pass", "VIP Delegate", "Exhibitor Pass"
  price        Float     @default(0)
  currency     String    @default("IDR")
  capacity     Int
  soldCount    Int       @default(0)
  // Hosted-buyer meeting quota for this tier. 0 means unlimited.
  meetingQuota Int       @default(0)
  benefitsJson String    @default("[]") // JSON array of perk descriptions
  bookings     Booking[]
  waitlist     WaitlistEntry[]
}

model WaitlistEntry {
  id           String      @id @default(cuid())
  eventId      String
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTierId String
  ticketTier   TicketTier  @relation(fields: [ticketTierId], references: [id], onDelete: Cascade)
  name         String
  email        String
  status       String      @default("PENDING") // PENDING | PROMOTED | CANCELLED
  promotedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@unique([ticketTierId, email])
  @@index([ticketTierId, status, createdAt])
}

model Booking {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id])
  ticketTierId  String
  ticketTier    TicketTier @relation(fields: [ticketTierId], references: [id])
  status        String    @default("CONFIRMED") // "RESERVED", "CONFIRMED", "CHECKED_IN", "CANCELLED"
  qrCodeHash    String    @unique
  attendeeName  String
  attendeeEmail String
  checkedInAt   DateTime?
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?
  createdAt     DateTime  @default(now())
  claims        VoucherClaim[]
  agendaBookmarks AgendaBookmark[]
  sessionCheckIns SessionCheckIn[]
  meetingRequests MeetingRequest[]
  idempotencyKey IdempotencyKey?
}

/**
 * Checkout idempotency ledger. One row per `Idempotency-Key`: a retried
 * request returns the stored pass instead of booking again. Rows expire
 * after 24 hours; a sweep on each checkout keeps the table bounded.
 */
model IdempotencyKey {
  key          String   @id
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fingerprint  String
  signature    String
  payloadString String
  svgQr        String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

/**
 * Email suppression list. A hard bounce or spam complaint for an address
 * stops all non-OTP mail to it: continuing to mail complainers burns the
 * sender reputation, and mailing dead addresses is pointless. OTP codes
 * always send — suppressing them would lock people out of their accounts.
 */
model EmailSuppression {
  email     String   @id // lowercased recipient
  reason    String   // HARDBOUNCE | COMPLAINT
  source    String   @default("")
  createdAt DateTime @default(now())
}

model AgendaItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  speakerName String?
  speakerRole String?
  location    String   // "Main Stage - Hall A1"
  startTime   DateTime
  endTime     DateTime
  track       String?
  bookmarks   AgendaBookmark[]
  checkIns    SessionCheckIn[]
}

model SessionCheckIn {
  id           String     @id @default(cuid())
  bookingId    String
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agendaItemId String
  agendaItem   AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  checkedInAt  DateTime   @default(now())

  @@unique([bookingId, agendaItemId])
  @@index([agendaItemId])
}

model AgendaBookmark {
  id           String     @id @default(cuid())
  bookingId    String
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agendaItemId String
  agendaItem   AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([bookingId, agendaItemId])
  @@index([bookingId])
}

model BoothTenant {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  companyName String
  boothNumber String   // "Hall A2 - B12"
  hallName    String   // "Hall A2"
  industry    String?
  websiteUrl  String?
  logoUrl     String?
  description String?
  dimensions  String?  // e.g. "3m x 3m", "6m x 3m"
  areaSqm     Float?   // e.g. 9.0, 18.0
  boothType   String?  // "SHELL_SCHEME", "RAW_SPACE", "ISLAND", "CORNER"
  // Claim state: an exhibitor asks for a booth, the organizer approves.
  userId      String?
  claimedBy   User?    @relation("BoothClaims", fields: [userId], references: [id], onDelete: SetNull)
  claimStatus String   @default("UNCLAIMED") // UNCLAIMED | PENDING | CLAIMED | REJECTED
  claimedAt   DateTime?
  meetingRequests MeetingRequest[]

  @@index([userId])
  @@index([eventId, claimStatus])
}

model EventPerk {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title        String   // "VIP Lounge Access & Barista Coffee"
  description  String
  tierRequired String?  // Legacy name label ("VIP") or null for all tiers
  tierId       String?  // Exact ticket tier gate; compared by id when set
  iconName     String   @default("Coffee")
  claims       VoucherClaim[]
}

model VoucherClaim {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  perkId    String
  perk      EventPerk @relation(fields: [perkId], references: [id], onDelete: Cascade)
  code      String   @unique // Deterministic hash code staff can verify
  createdAt DateTime @default(now())

  @@unique([bookingId, perkId])
}

model AIReport {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  modelUsed   String   // e.g. "google/gemini-3.7-flash"
  reportType  String   // "DAILY_DIGEST", "SENTIMENT", "FOOT_TRAFFIC"
  contentJson String   // Structured metrics & analysis markdown
  createdAt   DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 of the opaque cookie token; token itself never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id         String   @id @default(cuid())
  email      String
  codeHash   String   // SHA-256 of the 6-digit code; code itself never stored
  purpose    String   @default("LOGIN") // LOGIN, VERIFY_EMAIL, RESET_PASSWORD
  attempts   Int      @default(0)
  maxAttempts Int     @default(5)
  expiresAt  DateTime
  consumedAt DateTime?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  // Resolved user id; null for anonymous/demo-less calls
  actorRole String?  // ADMIN, ORGANIZER, ATTENDEE, or null
  action    String   // e.g. event.delete, booth.bulk-import, pass.override
  entity    String   // event, venue, booth, booking, user, session
  entityId  String?
  metadata  String?  // JSON-encoded context (titles, counts, reasons)
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
}

model MeetingRequest {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // RFQ | DEAL_SLOT | BUYER_APPOINTMENT | BILATERAL_SLOT | DEAL_ROOM
  type           String
  requesterName  String
  requesterEmail String
  // Booth company, deal opportunity, pavilion or delegation, as named in the UI.
  target         String   @default("")
  // Preferred slot or date range, free text; empty when the form asks for none.
  slot           String   @default("")
  message        String   @default("")
  // PENDING | CONFIRMED | DECLINED
  status         String   @default("PENDING")
  // Shared identity: who asked, which pass proves attendance, which booth is
  // the other side. All nullable because public forms predate accounts.
  requesterId    String?
  requester      User?        @relation("RequesterMeetings", fields: [requesterId], references: [id], onDelete: SetNull)
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  boothId        String?
  booth          BoothTenant? @relation(fields: [boothId], references: [id], onDelete: SetNull)
  // Organizer-set schedule. Null until a confirmed time exists.
  scheduledAt    DateTime?
  location       String   @default("")
  // Kept-meeting tracking: NONE until the organizer records what happened.
  outcome        String   @default("NONE") // NONE | HELD | NO_SHOW
  // Requester's 1-5 rating of a held meeting. Null until rated.
  rating         Int?
  createdAt      DateTime @default(now())

  @@index([eventId, status])
  @@index([requesterId])
}

// Editor-composed homepage rows. `regionId` null means all editions.
// Positions are managed by the API, never supplied by clients.
model HomepageRow {
  id            String   @id @default(cuid())
  title         String
  titleI18n     Json?
  subtitle      String?
  subtitleI18n  Json?
  regionId      String?
  position      Int
  eventIdsJson  String   @default("[]")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([regionId, position])
}
